PORT=
# Absolute URL, e.g. https://app.example.com (http://localhost:3000 in dev). Baked in at build time.
NEXT_PUBLIC_BASE_DOMAIN=http://localhost:3000
# docker-compose Postgres in dev.
DB_URL=postgres://app:app@localhost:5433/app
# Local docker-compose Postgres for `npm test`; never staging.
TEST_DB_URL=postgres://app:app@localhost:5433/app
