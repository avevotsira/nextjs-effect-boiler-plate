# env files: every variant holds secrets; only the template is committed
.env*
!.env.example

# keys and certificates
*.pem
*.key
*.crt

# logs
*.log
npm-debug.log*
.pnpm-debug.log*

# agents and editors: shared config is committed (.claude/skills, .claude/commands,
# .cursor, .vscode); per-person settings are not
.claude/settings.local.json
CLAUDE.local.md
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini
