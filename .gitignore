# dependencies
/node_modules

# next.js build output and generated types
/.next/
/out/
/build/
next-env.d.ts
*.tsbuildinfo

# deploy adapters
/.vercel/
/.open-next/

# tests: vitest coverage, Playwright results and screenshots
/coverage/
/test-results/
/playwright-report/
/blob-report/
