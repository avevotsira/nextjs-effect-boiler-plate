{
  "name": "nextjs-effect-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format:write": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:user": "tsx --env-file=.env scripts/seed-user.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "staged": "npm run lint && npm run format:check && npm run typecheck && npm run test && echo \"\n✅ All checks passed!\n\"",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.0-beta.83",
    "@hookform/resolvers": "^5.2.2",
    "@justmiracle/result": "^2.0.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-query-devtools": "^5.60.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.83",
    "lucide-react": "^0.563.0",
    "next": "^16.3.4",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@effect/tsgo": "0.48.0",
    "@oxlint/plugins": "^1.81.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/eslint-plugin-query": "^5.59.20",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "oxfmt": "^0.66.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "^1.63.0",
    "shadcn": "^4.4.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
}
